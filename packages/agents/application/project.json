{
  "name": "agents-application",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/agents/application/src",
  "projectType": "library",
  "tags": [
    "scope:agents",
    "layer:application"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/agents/application",
        "main": "packages/agents/application/src/index.ts",
        "tsConfig": "packages/agents/application/tsconfig.lib.json",
        "assets": [
          "packages/agents/application/*.md"
        ]
      }
    }
  }
}
