{
  "name": "conversations-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/conversations/domain/src",
  "projectType": "library",
  "tags": [
    "scope:conversations",
    "layer:domain"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/conversations/domain",
        "main": "packages/conversations/domain/src/index.ts",
        "tsConfig": "packages/conversations/domain/tsconfig.lib.json",
        "assets": [
          "packages/conversations/domain/*.md"
        ]
      }
    }
  }
}
