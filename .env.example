# HTTP port of the API
PORT=3000

# MongoDB: the single-node replica set from docker-compose.yml (docker compose up -d --wait).
# Pointing at another replica set, such as the shared 3-node setup, only needs these three values.
MONGODB_HOSTS=localhost:27017
MONGODB_DATABASE=assignment
MONGODB_REPLICA_SET=mongodb-test
MONGODB_POOL_SIZE=10

# Integration tests only. The name must end in _test; each suite adds its own suffix
# (assignment_api_test, assignment_agents_infra_test) and drops its database afterwards.
MONGODB_TEST_HOSTS=localhost:27017
MONGODB_TEST_REPLICA_SET=mongodb-test
MONGODB_TEST_DATABASE=assignment_test
